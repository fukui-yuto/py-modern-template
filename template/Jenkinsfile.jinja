{% if ci_platform == 'jenkins' %}
pipeline {
    agent {
        docker {
            image 'ghcr.io/astral-sh/uv:python{{ python_version }}-bookworm-slim'
            args '--user root'
        }
    }

    options {
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {
        stage('Install') {
            steps {
                sh 'uv sync --all-extras --frozen'
            }
        }

        stage('Lint') {
            parallel {
                stage('ruff check') {
                    steps {
                        sh 'uv run ruff check .'
                    }
                }
                stage('ruff format') {
                    steps {
                        sh 'uv run ruff format --check .'
                    }
                }
            }
        }

        stage('Type Check') {
            steps {
                sh 'uv run mypy src tests'
            }
        }

        stage('Test') {
            steps {
                sh 'uv run pytest --junitxml=report.xml'
            }
            post {
                always {
                    junit 'report.xml'
                }
            }
        }
    }

    post {
        cleanup {
            cleanWs()
        }
    }
}
{% elif ci_platform == 'gitlab_and_jenkins' and include_docker %}
pipeline {
    agent any

    options {
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    environment {
        // GitLab Container Registry の設定
        // 本番環境に合わせて変更してください
        REGISTRY_URL  = "${env.REGISTRY_URL  ?: 'registry.gitlab.com'}"
        IMAGE_NAME    = "${env.IMAGE_NAME    ?: '{{ project_slug }}'}"
        IMAGE_TAG     = "${env.IMAGE_TAG     ?: 'latest'}"
        DEPLOY_NAME   = '{{ project_slug }}'
    }

    stages {
        stage('Pull Image') {
            steps {
                script {
                    docker.withRegistry("https://${REGISTRY_URL}", REGISTRY_CRED) {
                        docker.image("${REGISTRY_URL}/${IMAGE_NAME}:${IMAGE_TAG}").pull()
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                sh """
                    docker stop ${DEPLOY_NAME} || true
                    docker rm   ${DEPLOY_NAME} || true
                    docker run -d \\
                        --name ${DEPLOY_NAME} \\
                        --restart unless-stopped \\
                        --env-file .env \\
                        ${REGISTRY_URL}/${IMAGE_NAME}:${IMAGE_TAG}
                """
            }
        }

        stage('Smoke Test') {
            steps {
                sh """
                    sleep 5
                    docker exec ${DEPLOY_NAME} python -m {{ project_slug }}.cli hello --name jenkins
                """
            }
        }
    }

    post {
        failure {
            sh "docker logs ${DEPLOY_NAME} || true"
        }
        cleanup {
            cleanWs()
        }
    }
}
{% endif %}
